# AWS Configuration
# EC2/ECS 上では未設定でも IMDS から自動取得される。ローカル開発時のみ設定要
# AWS_REGION=ap-northeast-1

# IAM から取得、ローカル環境のみ設定要
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Application（デフォルト 3001 のため EC2 上では設定不要）
# PORT=3001

# Cognito パラメータは AWS SSM Parameter Store から取得されます:
#   /chatapp/COGNITO_AUTHORITY
#   /chatapp/COGNITO_CLIENT_ID
#   /chatapp/REDIRECT_URL
# ローカル開発時は IAM 認証情報か AWS_ACCESS_KEY_ID/SECRET を設定してください

# ECS deploy
AWS_ACCOUNT_ID=your_aws_account_id
ECR_REPO_NAME=your_ecr_repo_name
ECS_CLUSTER_NAME=your_ecs_cluster_name
ECS_SERVICE_NAME=your_ecs_service_name
ECS_TASK_DEFINITION=your_ecs_task_definition