{
  // TypeScript 配置
  "typescript.tsdk": "chat-app/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // 调试配置
  "debug.javascript.autoAttachFilter": "onlyWithFlag",
  "debug.javascript.terminalOptions": {
    "skipFiles": [
      "<node_internals>/**",
      "node_modules/**"
    ]
  },

  // 文件排除（提高性能）
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.next": true
  },

  // 搜索排除
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true
  },

  // 保存时自动格式化（可选）
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
